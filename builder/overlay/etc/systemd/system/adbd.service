[Unit]
Description=Android Debug Bridge Daemon (ADBD)
After=network.target usb-gadget-rndis.service
Wants=network.target

[Service]
Type=simple
User=user
Group=user
WorkingDirectory=/home/user
ExecStart=/usr/local/bin/py_adbd.py
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
