#!/bin/bash
# ==============================================================================
# openstick-wifi-watchdog
# Smart Wi-Fi & Hotspot Supervisor for OpenStick (Snapdragon 410 / MSM8916)
#
# Logic:
# 1. Fresh Install / Belum pernah konek Wi-Fi:
#    - Langsung aktifkan Hotspot internal saat boot (< 5 detik).
#    - Jangan lakukan disconnect / scan / fallback periodik (Hotspot tetap menyala tenang).
#
# 2. Pernah koneksi Wi-Fi client sebelumnya (profil tersimpan):
#    - Saat boot: beri waktu hingga 15 detik agar NetworkManager auto-connect ke Wi-Fi.
#    - Jika belum terhubung ke Wi-Fi & tidak ada Hotspot aktif: nyalakan Hotspot fallback.
#    - Loop pemantau: Jika koneksi Wi-Fi terputus >= 60 detik: nyalakan Hotspot fallback.
#    - Jika Hotspot fallback aktif & TIDAK ADA pengguna aktif (SSH/ADB) >= 60 detik:
#      coba sambungkan kembali ke Wi-Fi client terakhir yang pernah terhubung.
#    - Jika ada pengguna aktif: tahan Hotspot dan jangan putuskan koneksi.
# ==============================================================================

STATE_DIR="/etc/openstick"
mkdir -p "$STATE_DIR"
LAST_WIFI_FILE="$STATE_DIR/last_wifi_profile"

OFFLINE_COUNT=0
HOTSPOT_IDLE_COUNT=0
CHECK_INTERVAL=5

has_active_user() {
    # Periksa sesi SSH aktif (port 22)
    if ss -tn '( sport = :22 or dport = :22 )' 2>/dev/null | grep -q "ESTAB"; then
        return 0
    fi
    # Periksa user login lokal / tty
    if who 2>/dev/null | grep -qv '^$'; then
        return 0
    fi
    # Periksa proses shell interaktif ADB
    if pgrep -f "py_adbd.py" >/dev/null 2>&1; then
        local adb_pid
        adb_pid=$(pgrep -f "py_adbd.py" | head -n 1)
        if [ -n "$adb_pid" ] && pgrep -P "$adb_pid" >/dev/null 2>&1; then
            return 0
        fi
    fi
    return 1
}

get_active_wifi_client() {
    local active_conns
    active_conns=$(nmcli -t -f NAME,TYPE con show --active 2>/dev/null)
    echo "$active_conns" | while IFS=':' read -r c_name c_type; do
        if [ "$c_type" = "802-11-wireless" ] || [ "$c_type" = "wifi" ]; then
            if [ "$c_name" != "hotspot" ] && [ "$c_name" != "Hotspot" ]; then
                echo "$c_name"
                return 0
            fi
        fi
    done
}

is_hotspot_active() {
    nmcli -t -f NAME,TYPE con show --active 2>/dev/null | grep -Eiq "^(hotspot|Hotspot):(802-11-wireless|wifi)"
}

has_saved_wifi_client() {
    nmcli -t -f TYPE,NAME con show 2>/dev/null | grep -E '^(802-11-wireless|wifi):' | grep -Eiv ':(hotspot|Hotspot)$' | grep -q '.'
}

ensure_hotspot_profile() {
    if ! nmcli con show "hotspot" >/dev/null 2>&1 && ! nmcli con show "Hotspot" >/dev/null 2>&1; then
        nmcli con add type wifi ifname wlan0 master br0 con-name hotspot ssid "4G-UFI-XX" >/dev/null 2>&1 || true
        nmcli con modify hotspot 802-11-wireless.mode ap 802-11-wireless.band bg 802-11-wireless.channel 1 >/dev/null 2>&1 || true
        nmcli con modify hotspot wifi-sec.key-mgmt wpa-psk wifi-sec.psk "1234567890" >/dev/null 2>&1 || true
        nmcli con modify hotspot wifi-sec.proto rsn wifi-sec.pairwise ccmp wifi-sec.group ccmp wifi-sec.pmf disable >/dev/null 2>&1 || true
        nmcli con modify hotspot connection.autoconnect yes connection.autoconnect-priority 100 >/dev/null 2>&1 || true
        nmcli con modify hotspot ipv4.method disabled ipv6.method disabled >/dev/null 2>&1 || true
    fi
}

start_hotspot() {
    ensure_hotspot_profile
    timeout 10 nmcli con up "hotspot" >/dev/null 2>&1 || timeout 10 nmcli con up "Hotspot" >/dev/null 2>&1 || true
}

# --- 1. BOOT INITIALIZATION ---
# Tunggu wlan0 terdeteksi oleh kernel (maksimal 10 detik)
for i in $(seq 1 10); do
    if ip link show wlan0 >/dev/null 2>&1; then
        break
    fi
    sleep 1
done

# KONDISI A: FRESH INSTALL / BELUM PERNAH TERHUBUNG KE WI-FI CLIENT
if ! has_saved_wifi_client; then
    logger -t openstick-watchdog "Fresh install detected (no saved client Wi-Fi). Starting Hotspot immediately..."
    start_hotspot
else
    # KONDISI B: SUDAH PERNAH TERKONEKSI KE WI-FI CLIENT
    # Beri NetworkManager waktu hingga 15 detik untuk mencoba auto-connect
    logger -t openstick-watchdog "Saved client Wi-Fi found. Waiting for auto-connection..."
    for i in $(seq 1 15); do
        if [ -n "$(get_active_wifi_client)" ]; then
            break
        fi
        sleep 1
    done

    # Jika setelah 15 detik belum tersambung dan hotspot belum aktif, nyalakan hotspot fallback
    if [ -z "$(get_active_wifi_client)" ] && ! is_hotspot_active; then
        logger -t openstick-watchdog "Client Wi-Fi not connected after boot timeout. Starting fallback Hotspot..."
        start_hotspot
    fi
fi

# --- 2. SUPERVISOR LOOP ---
while true; do
    client_conn=$(get_active_wifi_client)

    if [ -n "$client_conn" ]; then
        # Wi-Fi Client sedang terhubung aktif
        echo "$client_conn" > "$LAST_WIFI_FILE"
        OFFLINE_COUNT=0
        HOTSPOT_IDLE_COUNT=0
    elif is_hotspot_active; then
        # Hotspot sedang aktif
        OFFLINE_COUNT=0
        
        # Fitur reconnect Wi-Fi client HANYA berjalan jika openstick sudah pernah koneksi Wi-Fi client
        if has_saved_wifi_client && [ -f "$LAST_WIFI_FILE" ]; then
            if has_active_user; then
                # Ada pengguna login (SSH/ADB), tahan Hotspot dan reset counter
                HOTSPOT_IDLE_COUNT=0
            else
                HOTSPOT_IDLE_COUNT=$((HOTSPOT_IDLE_COUNT + CHECK_INTERVAL))
                if [ $HOTSPOT_IDLE_COUNT -ge 60 ]; then
                    last_target=$(head -n 1 "$LAST_WIFI_FILE" 2>/dev/null | tr -d '\r\n')
                    if [ -n "$last_target" ] && nmcli con show "$last_target" >/dev/null 2>&1; then
                        logger -t openstick-watchdog "No user active for 60s. Trying to reconnect to known Wi-Fi '$last_target'..."
                        
                        # Hentikan hotspot sementara untuk pemindaian/koneksi
                        timeout 5 nmcli con down "hotspot" >/dev/null 2>&1 || timeout 5 nmcli con down "Hotspot" >/dev/null 2>&1 || true
                        sleep 2
                        
                        # Coba sambungkan ke Wi-Fi client
                        timeout 25 nmcli con up "$last_target" >/dev/null 2>&1 || true
                        sleep 2
                        
                        new_client=$(get_active_wifi_client)
                        if [ -z "$new_client" ]; then
                            logger -t openstick-watchdog "Reconnect to '$last_target' failed. Restoring Hotspot."
                            start_hotspot
                        else
                            logger -t openstick-watchdog "Successfully reconnected to Wi-Fi '$last_target'!"
                        fi
                    fi
                    HOTSPOT_IDLE_COUNT=0
                fi
            fi
        else
            # Fresh install / belum ada Wi-Fi client tersimpan: Hotspot tetap stabil tanpa pencarian/pemutusan
            HOTSPOT_IDLE_COUNT=0
        fi
    else
        # Kondisi terputus (tidak ada client & tidak ada hotspot aktif)
        HOTSPOT_IDLE_COUNT=0
        OFFLINE_COUNT=$((OFFLINE_COUNT + CHECK_INTERVAL))
        
        # Jika belum ada Wi-Fi client tersimpan, aktifkan kembali Hotspot seketika (setelah 5s)
        # Jika ada Wi-Fi client tersimpan, tunggu toleransi disconnect 60s sebelum fallback ke Hotspot
        TRIGGER_TIMEOUT=60
        if ! has_saved_wifi_client; then
            TRIGGER_TIMEOUT=5
        fi

        if [ $OFFLINE_COUNT -ge $TRIGGER_TIMEOUT ]; then
            logger -t openstick-watchdog "Disconnected for >= ${TRIGGER_TIMEOUT}s. Starting Hotspot!"
            start_hotspot
            OFFLINE_COUNT=0
        fi
    fi

    sleep $CHECK_INTERVAL
done
